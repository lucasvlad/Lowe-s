# Supabase configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# `.env` is gitignored — never commit real values. The anon/public key is safe
# to expose in a client app (Row-Level Security protects your data); the
# service_role key must NEVER be put here or in the client.
#
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time. After
# changing them, restart the dev server with `npx expo start -c` to clear cache.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
